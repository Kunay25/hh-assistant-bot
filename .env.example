# PostgreSQL
# Замените postgres_here на пароль пользователя postgres и укажите свою БД
DATABASE_URL=postgresql+psycopg2://postgres:postgres_here@localhost:5432/hh_bot_db

# Токены мессенджеров (для запуска в консоли можно оставить пустыми)
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru

# ID администраторов (Telegram/MAX) через запятую для команд /stats и /update_kb
ADMIN_IDS=123456789

# Yandex Cloud (без ключей работает локальный поиск по документации)
YC_API_KEY=
YC_FOLDER_ID=
YC_ASSISTANT_ID=
YC_MODEL=yandexgpt-5.1

# Папки для документации и индекса Qdrant
DOCS_DIR=data/hh_docs
QDRANT_DIR=data/qdrant_db
