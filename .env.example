# === PostgreSQL ===
# Укажите пользователя, пароль, сервер, порт и название созданной базы данных.
# Пример (пароль postgres_here является заглушкой, замените его):
DATABASE_URL=postgresql+psycopg2://postgres:postgres_here@localhost:5432/hh_bot_db

# === Токены мессенджеров ===
# Для консольного режима токены не нужны.
TELEGRAM_BOT_TOKEN=
MAX_BOT_TOKEN=
MAX_API_URL=https://platform-api2.max.ru

# === Yandex Cloud (необязательно; без ключей работает локальный поиск) ===
YC_API_KEY=
YC_FOLDER_ID=
YC_ASSISTANT_ID=
YC_MODEL=yandexgpt-5.1

# === Локальная документация ===
DOCS_DIR=data/hh_docs

# Документация обновляется при запуске и каждые 6 часов работы бота.
# Для облачной генерации заполните YC_API_KEY и YC_FOLDER_ID.
